<Window x:Class="German.DeviceTrayHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="German'$ Device Tray Hub" Width="390" Height="510"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="False" Background="#01000000"
        WindowStartupLocation="Manual" Topmost="True">
    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="DEVICE TRAY HUB" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" CharacterSpacing="150"/>
                    <TextBlock Text="Ваши устройства" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="Состояние подключённых устройств" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="CloseButton" Content="×" Width="30" Height="30" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CloseButton_Click" FontSize="18" BorderThickness="0"
                        Background="Transparent"/>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="11" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                    <TextBlock Text="Обновление при открытии" FontSize="12" FontWeight="Medium"/>
                    <TextBlock x:Name="RefreshStatus" Text="Сейчас" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DeviceList"/>
            </ScrollViewer>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="Нажми значок в трее для обновления" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Button x:Name="StartupButton" Content="Автозапуск: —" HorizontalAlignment="Right"
                        Click="StartupButton_Click" Padding="10,6"/>
            </Grid>
        </Grid>
    </Border>
</Window>